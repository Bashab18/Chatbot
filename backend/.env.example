GEMINI_API_KEY=your_gemini_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
PORT=5000
# Secret used to sign JWT tokens — use a long random string in production
JWT_SECRET=change-this-to-a-long-random-secret
# Shared secret the mHealth mobile app presents to silently log in the
# already-signed-in local user, skipping this app's own login form.
# Must match the value baked into the Flutter app's chat_sso.dart.
DEVICE_SSO_SECRET=change-this-to-a-long-random-secret
